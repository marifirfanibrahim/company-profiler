# Copy this file to .env and fill in real values. .env is gitignored -- never commit real secrets.

# ---- environment selection ----
FLASK_ENV=development

# ---- LLM provider keys (only required for the provider(s) you actually use) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- OCR (optional feature, OCR_ENABLED=False by default) ----
OCR_TESSERACT_CMD=

# ---- Flask session secret (sourced now, enforced in Phase 3) ----
FLASK_SECRET_KEY=

# ---- outbound TLS verification (optional, defaults true) ----
HTTP_VERIFY_TLS=true
